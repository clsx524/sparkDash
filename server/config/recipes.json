    "tp": 1,
    "requiredNodes": [{ "role": "worker" }],
    "nodes": [
      {
        "role": "worker",
        "workdir": "~/MiniMax-H3-DGX-Spark",
        "startCmd": "make up",
        "stopCmd": "make down",
        "statusCmd": "make status",
        "runningPattern": "HTTP 200",
        "containerName": "minimax-h3-fl2va",
        "llmPort": 8000
      }
    ]
  },
  {
    "id": "deepseek-v41-lakyfx-tp3",
    "label": "DeepSeek-V4.1-Flash 1017 (EXL3 3.5bpw TensorFold, TP3)",
    "group": "multi-node",
    "tp": 3,
    "requiredNodes": [{ "role": "head" }, { "role": "worker" }, { "sparkId": "atom" }],
    "nodes": [
      {
        "role": "head",
        "workdir": "~/ds41f-1.2.0",
