[
  {
    "id": "glm53-exl3",
    "label": "GLM-5.3-Flash EXL3 (TP2, TensorFold)",
    "group": "dual-text-gen",
    "nodes": [
      {
        "role": "head",
        "workdir": "~/GLM-5.3-Flash-EXL3-2x-DGX-Sparks-TensorFold",
        "startCmd": "./link-registry-weights.sh && ./start.sh",
        "stopCmd": "./stop.sh",
        "statusCmd": "docker ps -a --filter 'name=^glm53-flash-tf$' --format '{{.Names}} {{.Status}}'",
        "runningPattern": "Up \\d",
        "containerName": "glm53-flash-tf",
        "llmPort": 8888,
        "modelIds": ["GLM-5.3-Flash-EXL3-4bpw-TensorFold", "GLM-5.3-Flash-DFlash2-bf582e4"]
      }
    ]
  },
  {
    "id": "qwen38-flash-next",
    "label": "Qwen3.8-Flash-Next (TP2+EP+MTP3)",
    "group": "dual-text-gen",
    "nodes": [
      {
        "role": "head",
        "workdir": "~/Qwen3.8-Flash-Next-Dual-DGX-Sparks",
        "startCmd": "./start.sh --launch",
        "stopCmd": "./stop.sh",
        "statusCmd": "docker inspect --format '{{.State.Status}}' vllm-fn",
        "runningPattern": "running",
        "containerName": "vllm-fn",
        "llmPort": 8888
      }
    ]
  },
  {
    "id": "minimax-h3",
    "label": "MiniMax H3 (single-node, worker)",
    "group": "single-node",
    "nodes": [
      {
        "role": "worker",
        "workdir": "~/MiniMax-H3-DGX-Spark",
        "startCmd": "make up",
        "stopCmd": "make down",
        "statusCmd": "make status",
        "runningPattern": "HTTP 200",
        "containerName": "minimax-h3-fl2va",
        "llmPort": 8000
      }
    ]
  },
  {
    "id": "deepseek-v41-3x",
    "label": "DeepSeek-V4.1-Flash (native, 3x TP3)",
    "group": "multi-node",
    "nodes": [
      {
        "role": "head",
        "workdir": "~/DeepSeek-v4.1-Flash-DGX-Sparks",
        "startCmd": "./start.sh serve",
        "stopCmd": "./start.sh stop",
        "statusCmd": "docker ps -a --filter 'name=^dsv41-head$' --format '{{.Names}} {{.Status}}'",
        "runningPattern": "Up \\d",
        "containerName": "dsv41-head",
        "llmPort": 8888
      }
    ]
  }
]
