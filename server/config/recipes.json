    "tp": 1,
    "requiredNodes": [{ "sparkId": "spark-2" }],
    "nodes": [
      {
        "role": "worker",
        "sparkId": "spark-2",
        "workdir": "~/MiniMax-H3-DGX-Spark",
        "startCmd": "make up",
        "stopCmd": "make down",
        "statusCmd": "make status",
        "runningPattern": "HTTP 200",
        "containerName": "minimax-h3-fl2va",
        "llmPort": 8000
      }
    ]
  },
